{
  "title": "ducat , cost overview",
  "uid": "ducat-overview",
  "tags": [
    "finops",
    "cost",
    "ducat"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "refresh": "1h",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "provider",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(ducat_cost_usd, provider)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "month",
        "label": "Month",
        "description": "Which billing month the snapshot panels show. ducat exposes every month as a label, so this filters without any time-range change.",
        "type": "query",
        "datasource": "${datasource}",
        "query": "label_values(ducat_cost_usd, month)",
        "includeAll": false,
        "multi": false,
        "sort": 2,
        "refresh": 1,
        "current": {}
      },
      {
        "name": "window",
        "label": "Snapshot window",
        "description": "How far back the snapshot panels look for the latest scrape. Raise above the scrape interval.",
        "type": "custom",
        "query": "5m,15m,30m,1h,6h,24h",
        "current": {
          "text": "1h",
          "value": "1h"
        },
        "options": [
          {
            "text": "5m",
            "value": "5m",
            "selected": false
          },
          {
            "text": "15m",
            "value": "15m",
            "selected": false
          },
          {
            "text": "30m",
            "value": "30m",
            "selected": false
          },
          {
            "text": "1h",
            "value": "1h",
            "selected": true
          },
          {
            "text": "6h",
            "value": "6h",
            "selected": false
          },
          {
            "text": "24h",
            "value": "24h",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "project",
        "type": "query",
        "datasource": "${datasource}",
        "query": {
          "query": "label_values(ducat_list_cost_usd, sub_account)",
          "refId": "project"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "Project / account",
        "definition": "label_values(ducat_list_cost_usd, sub_account)",
        "options": []
      },
      {
        "name": "service",
        "type": "query",
        "datasource": "${datasource}",
        "query": {
          "query": "label_values(ducat_list_cost_usd, service)",
          "refId": "service"
        },
        "includeAll": true,
        "multi": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*",
        "label": "Service",
        "definition": "label_values(ducat_list_cost_usd, service)",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Total spend (net) , $month",
      "description": "Billed cost after discounts/credits for the selected month.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum(last_over_time(ducat_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "instant": true
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "List cost (pre-discount) , $month",
      "description": "Public-rate / consumed value for the selected month (what the spend is worth before credits/discounts).",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum(last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "instant": true
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Savings vs list , $month",
      "description": "List minus net , the discount/credit value captured.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum(last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window])) - sum(last_over_time(ducat_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Effective discount , $month",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "100 * (1 - sum(last_over_time(ducat_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window])) / sum(last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window])))",
          "instant": true
        }
      ]
    },
    {
      "id": 9,
      "type": "barchart",
      "title": "List cost by project / linked account , $month",
      "description": "Per-project spend (GCP project, AWS linked account, Cloudflare account). Summed-away detail cannot be recovered by aggregation, which is why sub_account is a label rather than something computed later.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 0,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "showValue": "always",
        "legend": {
          "showLegend": false
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "format": "table",
          "instant": true,
          "legendFormat": "{{sub_account}}",
          "expr": "topk(15, sum by (sub_account) (last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window])))"
        }
      ]
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Adapter errors, last 6h",
      "description": "New provider/account fetch failures in the last 6h. Non-zero means some source did not return and every figure here is understated. Uses increase() so one historical failure does not latch the panel red.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "0",
                  "color": "green",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "instant": true,
          "expr": "sum(increase(ducat_scrape_error_total[6h])) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "piechart",
      "title": "Spend by provider , $month",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (provider) (last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "legendFormat": "{{provider}}",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "piechart",
      "title": "Spend by account , $month",
      "description": "By friendly account/project name (falls back to id).",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD"
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (billing_account_name) (last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "legendFormat": "{{billing_account_name}}",
          "instant": true
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Spend by month , per provider (list cost, all months)",
      "description": "Consumed value per billing month across the selected providers , the monthly history. Pick a month above to drill into services/accounts.",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "month": 0,
              "provider": 1,
              "Value": 2
            },
            "renameByName": {
              "month": "Month",
              "provider": "Provider",
              "Value": "List (USD)"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "Month",
                "desc": true
              }
            ]
          }
        }
      ],
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (month, provider) (last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\"}[$window]))",
          "format": "table",
          "instant": true
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Spend by service , $month (net / list / savings)",
      "datasource": "${datasource}",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2
        }
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "calculateField",
          "options": {
            "alias": "Savings (USD)",
            "mode": "binary",
            "binary": {
              "left": "Value #B",
              "operator": "-",
              "right": "Value #A"
            },
            "replaceFields": false
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "month": true
            },
            "renameByName": {
              "provider": "Provider",
              "billing_account_name": "Account",
              "service": "Service",
              "Value #A": "Net (USD)",
              "Value #B": "List (USD)"
            }
          }
        }
      ],
      "targets": [
        {
          "datasource": "${datasource}",
          "expr": "sum by (provider, billing_account_name, service) (last_over_time(ducat_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": "${datasource}",
          "expr": "sum by (provider, billing_account_name, service) (last_over_time(ducat_list_cost_usd{provider=~\"$provider\",sub_account=~\"$project\",service=~\"$service\",month=\"$month\"}[$window]))",
          "format": "table",
          "instant": true,
          "refId": "B"
        }
      ]
    }
  ]
}
