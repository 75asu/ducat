# Copy to `.env` in this directory and fill in. docker compose reads it
# automatically, and ducat-config.yaml pulls these in via ${VAR}.
#
# `.env` is gitignored. Nothing here is secret (GCP auth is ambient ADC), but all
# of it identifies your estate, so it stays out of the repo.

# --- GCP ---------------------------------------------------------------------
# Project holding the billing export, and the dataset inside it.
DUCAT_GCP_PROJECT=my-billing-project

# Your Cloud Billing account id, as shown in Billing > Account management.
# Format: XXXXXX-XXXXXX-XXXXXX
DUCAT_GCP_BILLING_ACCOUNT=000000-000000-000000

# For source=focus this is Google's managed dataset. Its name is
#   gcp_billing_immutable_<BILLING_ACCOUNT_WITH_UNDERSCORES>_<REGION>
# e.g. account 000000-000000-000000 in the US ->
#   gcp_billing_immutable_000000_000000_000000_us
# For source=standard it is whatever dataset you chose when enabling the export.
DUCAT_GCP_DATASET=gcp_billing_immutable_000000_000000_000000_us

# focus (default) or standard. See ducat-config.yaml for the trade-off.
DUCAT_GCP_SOURCE=focus

# Optional: project that runs the BigQuery job. Blank = same as DUCAT_GCP_PROJECT.
DUCAT_GCP_QUERY_PROJECT=

# --- Historical CSV import (optional) ----------------------------------------
# Host directory holding Console "Cost table" CSV exports for months that predate
# the BigQuery export. Keep it OUTSIDE this repo: the exports carry real project
# names and spend. Leave unset if you have no history to import.
BILLING_CSV_DIR=./billing-csv

# --- Other providers (uncomment the matching block in ducat-config.yaml) ------
# DUCAT_AWS_ACCOUNTS=
# DUCAT_CF_ACCOUNT=
# CLOUDFLARE_API_TOKEN=
# DUCAT_GITHUB_ORG=
# GITHUB_TOKEN=
