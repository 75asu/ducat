{
  "uid": "ducat-cost-local",
  "title": "ducat , cloud cost (local)",
  "description": "List vs billed cost from ducat. NOTE: ducat's scrape metrics are gauges labelled by MONTH, not a scrape-time series, so every panel here uses an instant query. On a credit-funded account billed trends to ~0 while list shows real consumption, so LIST is the headline.",
  "tags": [
    "ducat",
    "finops",
    "cost"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "5m",
  "time": {
    "from": "now-90d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "month",
        "label": "Month",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(ducat_list_cost_usd, month)",
          "refId": "month"
        },
        "refresh": 2,
        "sort": 4,
        "current": {},
        "includeAll": false,
        "multi": false
      },
      {
        "name": "provider",
        "label": "Provider",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(ducat_list_cost_usd, provider)",
          "refId": "provider"
        },
        "refresh": 2,
        "current": {},
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "project",
        "label": "Project",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(ducat_list_cost_usd, sub_account)",
          "refId": "project"
        },
        "refresh": 2,
        "current": {},
        "includeAll": true,
        "multi": true,
        "allValue": ".*"
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "PBFA97CFB590B2093"
        },
        "query": {
          "query": "label_values(ducat_list_cost_usd, service)",
          "refId": "service"
        },
        "refresh": 2,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "definition": "label_values(ducat_list_cost_usd, service)",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "List cost , $month",
      "description": "What was consumed at public rate. This is the honest headline on a credit-funded account: it is list-price-avoided, NOT cash saved.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Billed cost , $month",
      "description": "What is actually payable after credits and discounts. Near zero while credits absorb the spend.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ducat_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Absorbed by credits , $month",
      "description": "list minus billed. The gap credits are covering. When credits end, this becomes the cash bill.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"}) - sum(ducat_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"})",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Adapter errors, last 6h (0 = numbers trustworthy)",
      "description": "New adapter failures in the last 6h. Non-zero means the figures on this dashboard are incomplete, because a source did not return. Uses increase() rather than the raw counter so a single past failure does not pin it red.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(ducat_scrape_error_total[6h])) or vector(0)",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center"
      }
    },
    {
      "id": 5,
      "type": "barchart",
      "title": "List cost by month",
      "description": "Discrete billing periods, so bars rather than a line. Single series, so no legend is needed.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (month) (ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "List cost"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "month"
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "month",
        "orientation": "vertical",
        "showValue": "auto",
        "barRadius": 0.1,
        "groupWidth": 0.7,
        "barWidth": 0.8,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 6,
      "type": "barchart",
      "title": "Top 10 services by list cost , $month",
      "description": "Magnitude by identity. Horizontal because service names are long. This is the panel that answers 'where is the money going'.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (service) (ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "List cost"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "List cost",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "service",
        "orientation": "horizontal",
        "showValue": "always",
        "barRadius": 0.1,
        "groupWidth": 0.7,
        "barWidth": 0.85,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 8,
      "type": "barchart",
      "title": "List cost by PROJECT , $month",
      "description": "The 'which project is burning money' panel. Requires the sub_account label; without it projects are summed together and this question is unanswerable.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(12, sum by (sub_account) (ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "List cost",
              "sub_account": "Project"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "List cost",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 90,
            "gradientMode": "none",
            "axisSoftMin": 0
          }
        },
        "overrides": []
      },
      "options": {
        "xField": "Project",
        "orientation": "horizontal",
        "showValue": "always",
        "barRadius": 0.1,
        "groupWidth": 0.7,
        "barWidth": 0.85,
        "legend": {
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 9,
      "type": "table",
      "title": "Project x service , $month (top spend cells)",
      "description": "The cross-tab. Finds the single most expensive project+service pair, which is what an audit actually needs.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(25, sum by (sub_account, service) (ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"}))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "List cost",
              "sub_account": "Project",
              "service": "Service"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "List cost",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 0,
          "custom": {
            "align": "right"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byNames",
              "options": {
                "mode": "include",
                "names": [
                  "Project",
                  "Service"
                ]
              }
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "List cost"
          ]
        }
      }
    },
    {
      "id": 7,
      "type": "table",
      "title": "Service breakdown , $month (list vs billed)",
      "description": "The table view: every service, both measures side by side. Two measures of different magnitude belong in adjacent columns, never on a shared axis.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 23
      },
      "datasource": {
        "type": "prometheus",
        "uid": "PBFA97CFB590B2093"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (ducat_list_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "expr": "sum by (service) (ducat_cost_usd{provider=~\"$provider\", sub_account=~\"$project\", service=~\"$service\", month=\"$month\"})",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "service",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time 1": true,
              "Time 2": true
            },
            "renameByName": {
              "Value #A": "List cost",
              "Value #B": "Billed cost",
              "service": "Service"
            }
          }
        },
        {
          "id": "sortBy",
          "options": {
            "fields": {},
            "sort": [
              {
                "field": "List cost",
                "desc": true
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "decimals": 2,
          "custom": {
            "align": "right"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Service"
            },
            "properties": [
              {
                "id": "custom.align",
                "value": "left"
              },
              {
                "id": "unit",
                "value": "string"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "footer": {
          "show": true,
          "reducer": [
            "sum"
          ],
          "fields": [
            "List cost",
            "Billed cost"
          ]
        }
      }
    }
  ]
}
